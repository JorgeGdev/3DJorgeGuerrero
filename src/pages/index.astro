---
import { getCollection } from "astro:content";

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Component Imports
import CallToAction from "../components/CallToAction.astro";
import Grid from "../components/Grid.astro";
import Icon from "../components/Icon.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";

// Page section components
import ContactCTA from "../components/ContactCTA.astro";
import MainModel from "../components/dancingModel/MainModel.jsx";
import CarouselContainer from "../components/carrousel/CarouselContainer.jsx";
import TechModel from "../components/technologies/TechModel";
import BubblesModel from "../components/bubbles/BubblesModel";

// Content Fetching: List four most recent work projects
const projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
  <div class="stack gap-20 lg:gap-48">
    <header class="hero">
      <MainModel client:visible />
    </header>
    <main class="wrapper stack gap-20 lg:gap-48">
      <section class="section with-background bg-variant">
        <header id="headerAbout" class="section-header stack gap-2 lg:gap-4">
          <div class="aboutTitle">
            <h3>About Jorge</h3>
            <p class="aboutContent">
              I bring a strong mix of creativity, problem-solving, and adaptability. 
              I love translating ideas into visual experiences and I thrive when working on challenging interfaces, 
              animations, and user interactions. My background helps me connect with diverse teams and understand users from different cultures.
            </p>
          </div>

          <div class="cta">
            <CallToAction href="/about/">
              More About Me
              <Icon icon="arrow-right" size="1.2em" />
            </CallToAction>
          </div>
        </header>

        <div class="gallery">
          <Grid variant="small">
            {
              [
                "My Tech Toolbox",
                "Education and Training",
                "3D Experiences",
                "What I Like",
                "Work Experience",
              ].map((title, index) => (
                <li
                  class="mention-3d-wrapper"
                  style={`--delay: ${index * 0.15}s`}
                >
                  <div class="mention-3d-card">
                    <a href="/about/" class="mention-card-link">
                      <div class="mention-card-content">
                        <p>{title}</p>
                      </div>
                    </a>
                  </div>
                </li>
              ))
            }
          </Grid>
        </div>
      </section>

      <section class="carousel">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>My Laboratory</h3>
          <p>
            Each project in My Laboratory is a testament to my passion for 3D
            design and my relentless pursuit of innovation. Dive in and explore
            a realm where creativity knows no limits and every experiment brings
            new dimensions to life.
          </p>
        </header>

        <div class="carousel">
          <CarouselContainer client:load />
        </div>
      </section>

      <section class="tool_box">
        <header class="tool_box_box">
          <h3 class="tool_box_h3">My Tool Box</h3>
          <p class="tool_box_p">
            My toolbox is filled with technologies that allow me to transform
            ideas into interactive and immersive experiences. I work with
            JavaScript and Python to bring the logic behind each project to
            life, while React and Three.js enable me to create dynamic
            interfaces and 3D worlds that capture the imagination. Blender is
            where models take shape, and with HTML and CSS, I give everything
            style and structure. I also use GitHub to manage and share my code
            with the community.
          </p>
        </header>

        <div class="carousel">
          <BubblesModel client:load />
        </div>
      </section>

      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Some Web Sites</h3>
          <p>
            Welcome to my place, a creative haven where imagination meets
            technology. Here, I transform ideas into immersive 3D experiences
            that captivate and inspire. Utilizing cutting-edge tools like
            Three.js, Blender, and WebGL, I invent interactive worlds that push
            the boundaries of what's possible on the web.
          </p>
        </header>

        <div class="gallery">
          <Grid variant="offset">
            {
              projects.map((project) => (
                <li>
                  <PortfolioPreview project={project} />
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <CallToAction href="/work/">
            View All
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>

      <section class="goodbye">
        <header class="goodbye_box">
          <h3 class="goodbye_h3">PASSIONATE ABOUT CODE</h3>
          <p class="goodbye_p">
            It's not just about writing code; it's about creating worlds where
            people can lose themselves, interact, and enjoy. My goal is to keep
            learning and expanding my skills to build even more immersive and
            unique experiences that not only solve problems but also ignite the
            imagination and curiosity of those who experience them. Technology
            is my canvas, and every new challenge is an opportunity to paint
            something unforgettable.
          </p>
        </header>

        <div class="carousel">
          <TechModel client:visible />
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  /* ============== ESTILOS GENERALES ============================== */

.hero {
  height: 80vh;
  width: 90%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 6rem;
}

.roles {
  display: none;
}

/* =================== ABOUT SECTION ======================== */

#headerAbout {
  display: flex;
  flex-direction: row;
  max-width: 100ch;
  justify-content: space-between;
  align-items: center;
  gap: 2rem;
  padding: 2rem;
}

.aboutTitle {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 3rem;
  text-align: left;
}

.aboutContent {
  width: 80%;
  text-align: left;
  padding: 3rem 0;
}

.carousel,
.goodbye,
.tool_box {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.goodbye_box,
.tool_box_box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-family: "SuperAero", sans-serif;
}

.goodbye_h3,
.tool_box_h3 {
  font-size: 3.5rem;
  margin-bottom: 2rem;
  text-align: center;
  color: var(--gray-100);
}

.goodbye_p,
.tool_box_p {
  margin: 1.5rem 2rem;
  font-size: 1.25rem;
  line-height: 1.6;
  text-align: center;
  color: var(--gray-300);
}

/* ============== TARJETAS SECTION ABOUT ============================== */

.grid[variant="small"] {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  justify-content: center;
  perspective: 1000px;
  padding: 1rem;
}

.mention-3d-wrapper {
  animation: popFadeZoom 0.8s ease-out both;
  animation-delay: var(--delay, 0s);
}

.mention-3d-card {
  position: relative;
  width: clamp(180px, 40vw, 260px);
  height: clamp(140px, 25vh, 180px);
  background: radial-gradient(
    circle at var(--x, 50%) var(--y, 50%),
    #6565ff,
    #37056e
  );
  border-radius: 25px;
  box-shadow: 0 15px 25px rgba(0, 0, 0, 0.15);
  transform-style: preserve-3d;
  transition: background 0.3s ease, transform 0.3s ease;
  will-change: transform, background;
  overflow: hidden;
}

.mention-3d-card:hover {
  transform: rotateX(32deg) rotateY(32deg);
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
}

.mention-card-content {
  transform: translateZ(40px);
  padding: 1.5rem;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: clamp(1rem, 2vw, 1.2rem);
  font-weight: bold;
  color: #fff;
  font-family: "SuperAero", sans-serif;
}

.mention-card-link {
  display: block;
  width: 100%;
  height: 100%;
  text-decoration: none;
  color: inherit;
  border-radius: 20px;
}

@keyframes popFadeZoom {
  0% {
    opacity: 0;
    transform: scale(0.6) translateY(30px);
  }
  60% {
    opacity: 1;
    transform: scale(1.05) translateY(-4px);
  }
  80% {
    transform: scale(0.98) translateY(2px);
  }
  100% {
    transform: scale(1) translateY(0);
  }
}

/* =================== MEDIA QUERIES ======================== */

@media (max-width: 600px) {
  .grid[variant="small"] {
    flex-direction: column;
    align-items: center;
  }

  .mention-3d-card {
    width: 90vw;
    height: 160px;
  }

  .mention-card-content {
    font-size: 1rem;
  }

  #headerAbout,
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .aboutTitle {
    align-items: center;
    padding: 0;
    width: 100%;
  }

  .aboutContent {
    width: 90%;
    padding: 1rem 0;
    margin: 0;
    text-align: center;
  }

  .cta {
  display: flex;
  justify-content: center;
  width: auto;
  margin-top: 3rem;
  margin-bottom: 2rem;
}

  .carousel,
  .tool_box,
  .goodbye {
    height: auto;
    width: 100%;
    padding: 2rem;
    margin: 1rem 0;
  }

  .goodbye_h3,
  .tool_box_h3 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .goodbye_p,
  .tool_box_p {
    font-size: 1rem;
    margin: 1rem 1rem;
    line-height: 1.5;
  }
}

@media (min-width: 50em) {
  .hero {
    width: 90%;
    margin-left: 4rem;
  }

  .roles {
    display: flex;
    gap: 0.5rem;
  }

  .section {
    grid-template-columns: repeat(4, 1fr);
    gap: 5rem;
  }

  .section.with-cta {
    grid-template-areas: "header header header cta" "gallery gallery gallery gallery";
  }

  .section-header {
    grid-area: header;
    font-size: var(--text-lg);
    margin-top: 3em;
  }

  .section-header h3 {
    font-size: var(--text-4xl);
  }

  .section.with-cta .cta {
    grid-area: unset;
    justify-content: flex-start; /* o center si prefieres */
    width: fit-content;
    margin: 3rem auto; /* centrado */
  }
}

/* ============================
   MEDIA QUERIES ENTRE 601px Y 800px
   ============================ */
@media (min-width: 601px) and (max-width: 800px) {
  /* Espacio para el header About */
  #headerAbout {
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 2rem;
  }

  .aboutTitle {
    align-items: center;
    text-align: center;
  }

  .aboutContent {
    width: 100%;
    padding: 1rem;
  }

  /* Sección carousel y tool box */
  .carousel,
  .tool_box,
  .goodbye {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .section-header {
    margin-top: 3rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .section-header h3 {
    margin-bottom: 1rem;
  }

  .gallery {
    padding: 1rem;
    gap: 2rem;
  }

  .cta {
    margin-top: 2rem;
  }
}

/* ============================
   MEDIA QUERIES ENTRE 801px Y 1400px
   ============================ */
@media (min-width: 801px) and (max-width: 1400px) {
  /* Dar espacio vertical a las secciones */
  .carousel,
  .tool_box,
  .goodbye {
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  /* Espacio para headers */
  .section-header {
    margin-top: 4rem;
    margin-bottom: 3rem;
  }

  /* Galería con espacio */
  .gallery {
    padding: 2rem;
    gap: 3rem;
  }

  /* Botón con separación */
  .cta {
    margin-top: 3rem;
  }

  /* Espacio adicional si hay carrousels debajo de headers */
  .carousel > .section-header,
  .tool_box > .section-header {
    margin-bottom: 4rem;
  }
}

@media (max-width: 600px) {
  /* Ajuste para la sección Some Web Sites */
  .section-header {
    margin-top: 3rem;
    margin-bottom: 2rem;
    padding: 0 1.5rem;
    text-align: center;
  }

  .section-header h3 {
    margin-bottom: 1rem;
    font-size: 1.75rem;
  }

  .section-header p {
    font-size: 1rem;
    line-height: 1.5;
  }

  /* Espacio para la galería de imágenes */
  .gallery {
    padding-top: 2rem;
    padding-bottom: 3rem;
    gap: 1.5rem;
  }
}
@media (min-width: 600px) and (max-width: 800px) {
  .cta {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .cta a {
    max-width: 220px;
    width: 100%;
    text-align: center;
  }
}


</style>

<script>
  if (typeof window !== "undefined") {
    document.querySelectorAll(".mention-3d-card").forEach((el) => {
      const card = el as HTMLElement;

      card.addEventListener("mousemove", (e) => {
        const event = e as MouseEvent;
        const rect = card.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        card.style.setProperty("--x", `${x}px`);
        card.style.setProperty("--y", `${y}px`);
      });
    });
  }
</script>
